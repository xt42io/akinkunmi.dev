---
import Navbar from "../components/Navbar.astro";
import PostHog from "../components/posthog.astro";

import "../styles/global.css";

interface Props {
  title: string;
  /** Widen the content column — for data-heavy pages like /money. */
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Akinkunmi" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fdfcfa" />
    <link rel="preload" href="/font/nunito-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='hsl(0,70%,50%)'/></svg>"
    />
    <script is:inline>
      (function () {
        const hue = Math.floor(Math.random() * 360);
        const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='hsl(${hue},70%,50%)'/></svg>`;
        const link = document.querySelector("link[rel='icon']");
        if (link) link.href = "data:image/svg+xml," + encodeURIComponent(svg);
      })();
    </script>
    <meta name="generator" content="Akinkunmi" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://akinkunmi.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Akinkunmi" />
    <meta property="og:image" content="/og.png" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://akinkunmi.dev" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content="Akinkunmi" />
    <meta property="twitter:image" content="/og.png" />

    <PostHog />
  </head>
  <body class="bg-paper text-ink min-h-screen font-sans antialiased">
    <a href="#main" class="fixed left-6 top-4 z-50 -translate-y-24 rounded-md bg-ink px-4 py-2 text-sm text-paper focus:translate-y-0">Skip to content</a>
    <div
      class:list={[
        "site-shell",
        wide && "site-shell--wide",
      ]}
    >
      <Navbar />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>
