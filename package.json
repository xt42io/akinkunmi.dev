{
  "name": "akinkunmi.dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "wrangler dev",
    "astro": "astro",
    "test:now-playing": "node --test tests/now-playing.test.mjs",
