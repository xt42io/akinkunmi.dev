    "@auth/core": "^0.37.4",
    "astro": "^5.13.3",
    "auth-astro": "^4.2.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.541.0",
    "motion": "^12.38.0",
    "perfect-freehand": "^1.2.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "postgres": "^3.4.9",
